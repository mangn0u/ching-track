# Environment — copy this to .env and fill in values
# Never commit .env to git

SECRET_KEY=your-secret-key-here-change-this

DEBUG=True

DATABASE_URL=postgresql://chingtrack_user:chingtrack_pass@localhost:5432/chingtrack

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Email (use console backend in dev — set to SendGrid in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key

DEFAULT_FROM_EMAIL=noreply@chingtrack.com

# Frontend URL (used in email verification links)
FRONTEND_URL=http://localhost:5173
